.env
/target
/results
/dist

# Overpass response cache — a network cache, one per scenario. Deleting it
# just forces scripts/fetch_osm.py --scenario <id> to refetch.
data/osm_raw.json
data/scenarios/*/osm_raw.json

# Inspection-only duplicates of render_terrain.f32/fuel.i32/dem.f64,
# regenerated by scripts/build_render_terrain.py, clip_cogs.py etc. The
# non-.tif files are what the game actually reads.
data/spotorno_render_terrain.tif
data/scenarios/*/render_terrain.tif
data/scenarios/*/fuel.tif
data/scenarios/*/dem.tif

.DS_Store
*.pyc
__pycache__/
tools/mcp/.venv/
